{
  "name": "qa-automation-tests",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "ui": "npx playwright test --ui",
    "seeds": "PW_AGENT_MODE=1 npx playwright test --project seed-anonymous --project seed-admin --project seed-regular-user --project seed-plus-user",
    "agents:init": "PW_AGENT_MODE=1 npx playwright init-agents --loop=claude --project=seed-anonymous",
    "generate-report": "npx allure generate allure-results -o allure-report && npx allure open ./allure-report/",
    "open-report": "npx allure open ./allure-report/",
    "telegram": "java -DconfigFile=notifications/config.json -jar notifications/allure-notifications-4.9.0.jar"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@nodable/flexible-xml-parser": "^1.11.3",
    "@playwright/cli": "^0.1.13",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.0.3",
    "allure": "^3.2.0",
    "allure-playwright": "^3.4.5",
    "prettier": "^3.7.4"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "uuid": "^13.0.0"
  }
}
